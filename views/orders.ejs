<%- include('partials/header', { user: (typeof user !== 'undefined' ? user : null), title: 'My Orders' }) %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-1">My Orders</h2>
      <p class="text-muted mb-0">Track your recent purchases and delivery status.</p>
    </div>
    <% if (orders && orders.length) { %>
      <span class="badge bg-primary">
        <%= orders.length %> order<%= orders.length === 1 ? '' : 's' %>
      </span>
    <% } %>
  </div>

  <% if (!orders || orders.length === 0) { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <h5 class="mb-2">You have not placed any orders yet.</h5>
        <p class="text-muted mb-3">Browse our products and start shopping now.</p>
        <a href="/shopping" class="btn btn-primary">Go to Shopping</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% orders.forEach(function(o){ %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h5 class="card-title mb-1">Order #<%= o.id %></h5>
                  <small class="text-muted">Placed: <%= new Date(o.createdAt).toLocaleString('en-SG',{dateStyle:'medium', timeStyle:'short'}) %></small>
                </div>
                <div class="text-end">
                  <% const status = (o.deliveryStatus || o.status || 'processing').toLowerCase(); %>
                  <% let badgeClass = 'bg-secondary'; %>
                  <% if (status.includes('processing') || status.includes('packed')) { badgeClass = 'bg-info text-dark'; } %>
                  <% if (status.includes('shipped')) { badgeClass = 'bg-warning text-dark'; } %>
                  <% if (status.includes('delivered')) { badgeClass = 'bg-success'; } %>
                  <span class="badge <%= badgeClass %>">
                    <%= o.deliveryStatus || o.status || 'processing' %>
                  </span>
                </div>
              </div>

              <div class="mb-2">
                <div class="d-flex justify-content-between">
                  <span class="text-muted">Payment</span>
                  <span class="fw-semibold text-capitalize"><%= o.paymentMethod || 'card' %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted">Total</span>
                  <span class="fw-semibold">$<%= Number(o.total || (o.subtotal + o.deliveryCost)).toFixed(2) %></span>
                </div>
                <% if (o.refundStatus) { %>
                  <div class="d-flex justify-content-between mt-1">
                    <span class="text-muted">Refund</span>
                    <% const rs = o.refundStatus.toLowerCase(); %>
                    <% let refundBadge = 'bg-secondary'; %>
                    <% if (rs.includes('processing')) { refundBadge = 'bg-warning text-dark'; } %>
                    <% if (rs.includes('accepted') || rs.includes('completed')) { refundBadge = 'bg-success'; } %>
                    <% if (rs.includes('rejected')) { refundBadge = 'bg-danger'; } %>
                    <span class="badge <%= refundBadge %>"><%= o.refundStatus %></span>
                  </div>
                <% } %>
                <% if (o.estimatedDelivery) { %>
                  <div class="d-flex justify-content-between mt-1">
                    <span class="text-muted">Est. delivery</span>
                    <span><%= new Date(o.estimatedDelivery).toLocaleDateString('en-SG',{dateStyle:'medium'}) %></span>
                  </div>
                <% } %>
              </div>

              <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted">Tap to view items and details</small>
                <a href="/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">View details</a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
