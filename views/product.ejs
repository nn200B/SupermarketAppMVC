<%- include('partials/header', { user: (typeof user !== 'undefined' ? user : null), title: product ? product.productName : 'Product' }) %>

    <div class="container mt-4">
        <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
        <br>
        <div class="text-center"><h2>Product Details</h2></div>
        <br>
                <% if (product) { const stock = Number(product.quantity) || 0; %> <!-- Check if product data exists -->
                        <div>
                                <p><b>Product Name:</b><br> <%= product.productName %></p>
                                <p><b>Product Image:</b><br> <img src = "/images/<%= product.image %>" width="20%"></p>
                                <p><b>Product Quantity:</b><br> <%= stock %></p>
                                <p><b>Price:</b><br> $<%= (Number(product.price) || 0).toFixed(2) %></p>
                                <% if (user.role === 'user') { %>
                                    <% if (stock <= 0) { %>
                                        <p><span class="badge bg-secondary">Out of stock</span></p>
                                    <% } else { %>
                                        <form action="/add-to-cart/<%= product.id %>" method="POST" class="d-flex align-items-center mt-3">
                                            <label class="me-2 mb-0">Qty</label>
                                            <select name="quantity" class="form-select form-select-sm me-2" style="width:80px">
                                                <% const maxSelectable = Math.min(stock, 5); for (let q = 1; q <= maxSelectable; q++) { %>
                                                    <option value="<%= q %>"><%= q %></option>
                                                <% } %>
                                            </select>
                                            <button type="submit" class="btn btn-success btn-sm">Add to cart</button>
                                        </form>
                                    <% } %>
                                <% } %>
                        </div>
        <% } else { %>
            <p>No product found.</p>
        <% } %>
        <% if (user.role === "admin") { %>
          <a href ="/inventory">Back</a>
        <% } else { %>
          <a href ="/shopping">Back</a>
        <% } %>
    </div>

<%- include('partials/footer') %>
