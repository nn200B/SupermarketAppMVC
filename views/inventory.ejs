<%- include('partials/header', { user: (typeof user !== 'undefined' ? user : null), title: 'Inventory' }) %>

  <div class="container mt-4 mb-5 inventory-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <p class="text-muted mb-1">Welcome back,</p>
        <h2 class="mb-0">Admin Inventory</h2>
        <p class="text-muted small mb-0">Manage all products for your supermarket in one place.</p>
      </div>
      <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <div class="text-end">
          <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
            + Add New Product
          </button>
        </div>
      <% } %>
    </div>

    <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
      <div class="alert alert-info inventory-pill mb-4" role="alert">
        <strong>Admin panel:</strong> Use this page to review stock levels, pricing and quickly edit or remove products.
      </div>
    <% } %>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle inventory-table">
            <thead class="table-light">
                <tr>
                  <th>Product</th>
                  <th class="text-center d-none d-md-table-cell">Image</th>
                  <th class="text-center">Quantity</th>
                  <th class="text-end">Price</th>
                  <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
              <% if (products && products.length) { %>
                <% for(let i=0; i < products.length; i++) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="inventory-image-thumb d-md-none me-3">
                          <img src="/images/<%= products[i].image %>" alt="<%= products[i].productName %>" class="img-fluid rounded">
                        </div>
                        <div>
                          <a href="/product/<%= products[i].id %>" class="fw-semibold text-decoration-none text-dark">
                            <%= products[i].productName %>
                          </a>
                          <% if (products[i].category) { %>
                            <div class="small text-muted">Category: <%= products[i].category %></div>
                          <% } %>
                          <div class="badge bg-light text-secondary border small mt-1">ID: <%= products[i].id %></div>
                        </div>
                      </div>
                    </td>
                    <td class="text-center d-none d-md-table-cell">
                      <img src="/images/<%= products[i].image %>" alt="<%= products[i].productName %>" class="inventory-image-thumb img-fluid rounded">
                    </td>
                    <td class="text-center">
                      <span class="badge rounded-pill inventory-qty-chip">
                        <%= products[i].quantity %>
                      </span>
                    </td>
                    <td class="text-end">
                      <span class="fw-bold text-success">$<%= (Number(products[i].price) || 0).toFixed(2) %></span>
                    </td>
                    <td class="text-center">
                      <div class="btn-group btn-group-sm" role="group">
                        <a href="/updateProduct/<%= products[i].id %>" class="btn btn-outline-primary">Edit</a>
                        <a href="/deleteProduct/<%= products[i].id %>" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this product?')">Delete</a>
                      </div>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No products found. Use the "Add New Product" button to create one.</td>
                  </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  
    <!-- Add Product Modal (admin) -->
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addProductModalLabel">Add New Product</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <%- include('partials/addProductForm', { categories: (typeof categories !== 'undefined' ? categories : []) }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast container (kept for other features) -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
      <div id="toastContainer"></div>
    </div>
  </div>
  <%- include('partials/footer') %>
