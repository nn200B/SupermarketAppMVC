<%- include('partials/header', { user: (typeof user !== 'undefined' ? user : null), title: 'Home' }) %>

    <section class="hero">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6 left text-white">
            <div class="mb-2">Fresh Grocery Service & Restaurant</div>
            <h1>Get fresh Grocery<br>Enjoy healthy life.</h1>
            <p class="lead">Fast delivery, great prices and top-rated produce — right to your door.</p>

            <div class="search-controls d-flex gap-2 align-items-center mt-3">
              <select id="category" class="form-select w-auto">
                <option value="">All Categories</option>
                <option value="">All</option>
                <option value="fruits">Fruits</option>
                <option value="vegetables">Vegetables</option>
                <option value="dairy">Dairy</option>
                <option value="bakery">Bakery</option>
              </select>
              <button class="btn btn-cta" id="shopNowBtn">Shop Now</button>
              <% if (!user) { %>
                <a class="btn btn-outline-light-custom ms-2" href="/register">Sign up</a>
              <% } else { %>
                <a class="btn btn-outline-light-custom ms-2" href="/cart">View Cart</a>
              <% } %>
            </div>

            <!-- Download badges + review widget -->
            <div class="d-flex align-items-center gap-3 mt-3">
              <div class="download-badges d-flex gap-2">
                <img src="/images/google-play-badge.svg" alt="Google Play" style="height:44px"> 
                <img src="/images/app-store-badge.svg" alt="App Store" style="height:44px"> 
              </div>
              <div class="review-widget text-white">
                <div style="font-weight:800;font-size:18px">4.8 <span style="font-size:12px;font-weight:600">/ 5</span></div>
                <div style="opacity:0.9;font-size:13px">500+ reviews</div>
              </div>
            </div>

            <div class="badge-features">
              <div class="badge">Our Happy Customer - 4.8 (500+)</div>
              <div class="badge">Free Delivery over $30</div>
              <div class="badge">Secure Payment</div>
            </div>
          </div>
            <div class="col-md-6 right">
            <!-- Hero photo container: default uses the provided remote image; placing a local file at /public/images/hero-person.jpg will override it. -->
            <div class="hero-photo" aria-hidden="true" style="background-image: url('https://media.istockphoto.com/id/1284741845/photo/latin-american-employee-greengrocer-in-supermarket.jpg?s=612x612&w=0&k=20&c=25IoSz7r-NLfHsSPmRlEQbQkWHkXAyR7xFfS9-WWNqE=');">
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      document.getElementById('shopNowBtn').addEventListener('click', function(){
        var cat = document.getElementById('category').value;
        var url = '/shopping';
        if(cat) url += '?category=' + encodeURIComponent(cat);
        window.location.href = url;
      });
    </script>
<%- include('partials/footer') %>